# ExamLoop Environment Configuration Template
# Copy this file to .env and configure your environment.
# Never commit real API keys or credentials to version control.

# Application Environment
APP_ENV=development

# Database Connection
# Default SQLite local database:
DATABASE_URL=sqlite:///./backend/examloop.db
# PostgreSQL / pgvector connection example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/examloop

# Local File Storage Directory
STORAGE_DIR=./backend/storage

# Execution Mode:
# Set to 'false' to enable live NVIDIA Nemotron calls via Nebius Token Factory.
# Set to 'true' to use verified deterministic fixtures for zero-cost demo & testing.
DEMO_MODE=true

# Nebius Token Factory / NVIDIA Nemotron AI
NEBIUS_API_KEY=your_nebius_token_factory_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_FAST_MODEL=nvidia/nemotron-4-340b-instruct
NEBIUS_REASONING_MODEL=nvidia/nemotron-4-340b-instruct

# Embeddings & Vector Retrieval (Optional)
# If not configured, ExamLoop automatically uses the built-in BM25 lexical retriever.
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=none
EMBEDDING_API_KEY=
